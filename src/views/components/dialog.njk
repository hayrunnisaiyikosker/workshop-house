{% macro dialog(id, title, ariaLabelledBy) %}
<dialog id="{{ id }}" aria-labelledby="{{ ariaLabelledBy }}" class="modal-dialog">
  <div class="dialog-content">
    <div class="dialog-header">
      <h2 id="{{ ariaLabelledBy }}">{{ title }}</h2>
      <button type="button" class="btn btn-secondary close-dialog-btn" onclick="document.getElementById('{{ id }}').close()" aria-label="Close dialog">
        &times;
      </button>
    </div>
    <div class="dialog-body">
      {{ caller() }}
    </div>
  </div>
</dialog>
{% endmacro %}
