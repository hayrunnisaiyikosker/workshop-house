{% extends "layout.njk" %}

{% block content %}
<div style="max-width: 580px; margin: 0 auto;">
  <p><a href="/trainer/sessions/{{ session.id }}/attendance">&larr; Return to Attendance Roster</a></p>

  <h1>Check-in Terminal</h1>
  
  <div class="card" style="margin-bottom: 1.5rem;">
    <h2>{{ session.course_title }}</h2>
    <p style="margin: 0.25rem 0; color: var(--color-text-muted);">
      <strong>Schedule:</strong> {{ session.starts_at | formatDate }} &ndash; {{ session.ends_at | formatDate }} &bull;
      <strong>Room:</strong> {{ session.room }}
    </p>
    <div class="alert alert-info" style="margin-top: 1rem; margin-bottom: 0;">
      <small>
        <strong>Check-in Window:</strong> Allowed from 30 minutes prior to session start until the end of the session.
      </small>
    </div>
  </div>

  <div class="card">
    <h2>Scan or Enter Learner Check-in Code</h2>
    <p>Scan learner's QR code or manually enter their 8-character alphanumeric check-in code.</p>

    <form action="/trainer/sessions/{{ session.id }}/checkin" method="POST" novalidate style="margin-top: 1.5rem;">
      <div class="form-group">
        <label for="checkin-code-input" class="form-label" style="font-size: 1.1rem; font-weight: 700;">
          Check-in Code
        </label>
        <p id="code-hint" class="form-hint" style="font-size: 0.875rem; color: var(--color-text-muted);">
          Shortcut: Press <kbd>Alt</kbd>+<kbd>Shift</kbd>+<kbd>K</kbd> anytime to jump focus here.
        </p>
        <input
          id="checkin-code-input"
          name="code"
          type="text"
          placeholder="e.g. A3F82CPQ"
          class="form-input"
          style="font-size: 1.5rem; text-transform: uppercase; letter-spacing: 3px; font-weight: 700; text-align: center; height: 56px;"
          autocomplete="off"
          autofocus
          required
          aria-required="true"
          aria-describedby="code-hint"
          maxlength="8"
          pattern="[A-HJ-NP-Za-hj-np-z2-9]{8}"
        />
      </div>

      <div style="margin-top: 1.5rem;">
        <button type="submit" class="btn btn-primary" style="width: 100%; height: 50px; font-size: 1.1rem;">
          Record Check-in &rarr;
        </button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
