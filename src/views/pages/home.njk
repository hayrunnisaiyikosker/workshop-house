{% extends "layout.njk" %}

{% block content %}

{# ── Hero ──────────────────────────────────────────────────────────── #}
<section class="hero" aria-label="Welcome">
  <div class="hero__visual" aria-hidden="true"></div>
  <div class="hero__body">
    <h1 class="hero__title">Learn a craft by doing, together.</h1>
    <p class="hero__lead">Small-group workshops in hands-on skills. Book a seat, show up, and make something real.</p>
    <div class="hero__actions">
      <a href="/sessions" class="btn btn-primary">Browse All Workshops</a>
      {% if not currentUser %}
        <a href="/auth/login" class="btn btn-secondary">Sign In</a>
      {% endif %}
    </div>
  </div>
</section>

{# ── Signed-in user quick links ───────────────────────────────────── #}
{% if currentUser %}
  <div class="alert alert-info" role="status">
    <p>Signed in as <strong>{{ currentUser.name }}</strong> ({{ currentUser.role | capitalize }}).</p>
    <div class="hero__actions alert__actions">
      {% if currentUser.role == 'coordinator' %}
        <a href="/coordinator/sessions" class="btn btn-secondary">Coordinator Dashboard</a>
      {% elseif currentUser.role == 'trainer' %}
        <a href="/trainer/sessions" class="btn btn-secondary">Trainer Dashboard</a>
      {% else %}
        <a href="/my-sessions" class="btn btn-secondary">My Enrolled Sessions</a>
      {% endif %}
      <a href="/dashboard" class="btn btn-secondary">Analytics Dashboard</a>
    </div>
  </div>
{% endif %}

{# ── Upcoming sessions ────────────────────────────────────────────── #}
<section class="sessions-section" aria-labelledby="sessions-heading">
  <h2 id="sessions-heading" class="sessions-section__heading">Upcoming Workshops</h2>

  {% set allSessions = sessions | default([]) %}

  {% if allSessions.length == 0 %}
    <div class="empty-state" role="status">
      <p>No upcoming workshops are scheduled yet. Check back soon!</p>
    </div>

  {% else %}
    {# Featured (first) session #}
    {% set featured = allSessions[0] %}
    <article class="session-card session-card--featured" aria-labelledby="featured-title">
      <div class="session-card__header">
        <span class="session-card__label">Next up</span>
        <span class="session-card__seats">
          <span aria-hidden="true">&#10033;</span>
          {{ featured.remaining_seats }} of {{ featured.capacity }} seats left
        </span>
      </div>
      <h3 id="featured-title" class="session-card__title">{{ featured.course_title }}</h3>
      <p class="session-card__desc">{{ featured.course_description | truncate(160) }}</p>
      <dl class="session-card__meta">
        <div class="session-card__meta-item">
          <dt>When</dt>
          <dd>{{ featured.starts_at | formatDate }}</dd>
        </div>
        <div class="session-card__meta-item">
          <dt>Room</dt>
          <dd>{{ featured.room }}</dd>
        </div>
        <div class="session-card__meta-item">
          <dt>Trainer</dt>
          <dd>{{ featured.trainer_name }}</dd>
        </div>
      </dl>
      <a href="/sessions/{{ featured.id }}" class="btn btn-primary session-card__cta">View details</a>
    </article>

    {# Remaining sessions as smaller cards #}
    {% if allSessions.length > 1 %}
      <div class="session-grid" aria-label="More upcoming sessions">
        {% for session in allSessions %}
          {% if loop.index > 1 and loop.index <= 4 %}
            <article class="session-card" aria-labelledby="session-title-{{ loop.index }}">
              <div class="session-card__header">
                <span class="session-card__seats">
                  {{ session.remaining_seats }} / {{ session.capacity }} free
                </span>
              </div>
              <h3 id="session-title-{{ loop.index }}" class="session-card__title">{{ session.course_title }}</h3>
              <p class="session-card__desc">{{ session.course_description | truncate(80) }}</p>
              <div class="session-card__footer">
                <span class="session-card__meta-inline">{{ session.starts_at | formatDate }} &bull; {{ session.trainer_name }}</span>
                <a href="/sessions/{{ session.id }}" class="btn btn-secondary session-card__cta-sm">View</a>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="sessions-section__more">
      <a href="/sessions" class="btn btn-secondary">See all workshops &rarr;</a>
    </div>
  {% endif %}
</section>

{# ── Roles section ────────────────────────────────────────────────── #}
<section class="roles-section" aria-labelledby="roles-heading">
  <h2 id="roles-heading" class="roles-section__heading">Built for everyone in the studio</h2>
  <div class="roles-grid">

    <article class="role-card" aria-labelledby="role-learner">
      <h3 id="role-learner" class="role-card__title">Learners</h3>
      <p class="role-card__desc">Browse hands-on workshops and reserve your seat. All materials are ready at the bench.</p>
      <a href="/sessions" class="btn btn-primary role-card__cta">Explore workshops</a>
    </article>

    <article class="role-card" aria-labelledby="role-trainer">
      <h3 id="role-trainer" class="role-card__title">Trainers</h3>
      <p class="role-card__desc">Working practitioners who lead small-group sessions and guide every project step by step.</p>
      <a href="/trainer/sessions" class="btn btn-primary role-card__cta">My sessions</a>
    </article>

    <article class="role-card" aria-labelledby="role-coordinator">
      <h3 id="role-coordinator" class="role-card__title">Coordinators</h3>
      <p class="role-card__desc">Studio hosts who curate monthly schedules, prepare tools, and welcome every group.</p>
      <a href="/coordinator/sessions" class="btn btn-primary role-card__cta">Manage sessions</a>
    </article>

  </div>
</section>

{% endblock %}
