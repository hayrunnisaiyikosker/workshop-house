<!DOCTYPE html>
<html lang="en" 
  data-text-scale="{{ currentUser.preferences.text_scale or '100' }}"
  data-high-contrast="{{ 'true' if currentUser.preferences.high_contrast else 'false' }}"
  data-reduced-motion="{{ 'true' if currentUser.preferences.reduced_motion else 'false' }}"
>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ pageTitle or "Workshop House" }}</title>
  <link rel="stylesheet" href="/css/theme.css" />
  <script src="/js/shortcuts.js" defer></script>
  {% block head %}{% endblock %}
</head>
<body data-shortcuts-enabled="{{ 'false' if currentUser and currentUser.preferences and currentUser.preferences.shortcuts_enabled == false else 'true' }}">
  <!-- Skip to main content link (WCAG 2.4.1) -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Header landmark (WCAG 1.3.1) -->
  <header class="site-header" role="banner">
    <div class="header-container">
      <a href="/" class="brand-link" aria-label="Workshop House homepage">Workshop House</a>
      
      <!-- Nav landmark (WCAG 1.3.1) -->
      <nav class="main-nav" aria-label="Main navigation">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/sessions">Workshops</a></li>
          {% if currentUser %}
            <li><a href="/dashboard">Dashboard</a></li>
            {% if currentUser.role == 'coordinator' %}
              <li><a href="/coordinator/sessions">Manage Sessions</a></li>
              <li><a href="/coordinator/courses">Manage Courses</a></li>
            {% endif %}
            {% if currentUser.role == 'trainer' %}
              <li><a href="/trainer/sessions">My Sessions</a></li>
            {% endif %}
            {% if currentUser.role == 'learner' %}
              <li><a href="/my-sessions">My Sessions</a></li>
            {% endif %}
            <li><a href="/preferences">Preferences</a></li>
            <li>
              <button type="button" class="btn btn-secondary nav-btn" onclick="document.getElementById('shortcuts-dialog').showModal()" aria-haspopup="dialog" style="min-height: 36px; padding: 0.25rem 0.5rem; font-size: 0.875rem;">
                Shortcuts (<kbd>Alt+Shift+H</kbd>)
              </button>
            </li>
            <li>
              <span>Signed in as <strong>{{ currentUser.name }}</strong> ({{ currentUser.role }})</span>
            </li>
            <li>
              <form action="/auth/logout" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-secondary nav-btn">Sign Out</button>
              </form>
            </li>
          {% else %}
            <li><a href="/auth/login" class="btn btn-primary nav-btn">Sign In</a></li>
          {% endif %}
        </ul>
      </nav>
    </div>
  </header>

  <!-- Flash messages live regions (WCAG 4.1.3) -->
  {% if flashSuccess %}
    <div class="site-main" style="min-height: auto; margin-bottom: 0;">
      <div class="alert alert-success" role="status" aria-live="polite">
        {{ flashSuccess }}
      </div>
    </div>
  {% endif %}
  {% if flashError %}
    <div class="site-main" style="min-height: auto; margin-bottom: 0;">
      <div class="alert alert-error" role="alert" aria-live="assertive">
        {{ flashError }}
      </div>
    </div>
  {% endif %}

  <!-- Main content landmark (WCAG 1.3.1) -->
  <main id="main-content" class="site-main">
    {% block content %}{% endblock %}
  </main>

  <!-- Keyboard Shortcuts Dialog (WCAG 2.1.4) -->
  <dialog id="shortcuts-dialog" aria-labelledby="shortcuts-dialog-title" class="modal-dialog" style="max-width: 500px; padding: 1.5rem; border: 2px solid var(--color-border); border-radius: var(--border-radius); background: var(--color-surface); color: var(--color-text);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--color-border); padding-bottom: 0.5rem;">
      <h2 id="shortcuts-dialog-title" style="margin: 0; font-size: 1.25rem;">Keyboard Shortcuts</h2>
      <button type="button" class="btn btn-secondary" onclick="document.getElementById('shortcuts-dialog').close()" aria-label="Close shortcuts dialog" style="min-height: 32px; padding: 0.2rem 0.5rem;">
        &times;
      </button>
    </div>
    <p style="font-size: 0.875rem; color: var(--color-text-muted);">
      Press the key combinations below to quickly navigate. You can disable shortcuts anytime in <a href="/preferences">Preferences</a>.
    </p>
    <ul style="list-style: none; padding: 0; margin: 1rem 0; display: flex; flex-direction: column; gap: 0.75rem;">
      <li style="display: flex; justify-content: space-between;">
        <span>Browse Workshops:</span>
        <kbd style="padding: 0.2rem 0.4rem; background: var(--color-surface-hover); border: 1px solid var(--color-border); border-radius: 4px;">Alt + Shift + S</kbd>
      </li>
      <li style="display: flex; justify-content: space-between;">
        <span>My Enrolled Sessions:</span>
        <kbd style="padding: 0.2rem 0.4rem; background: var(--color-surface-hover); border: 1px solid var(--color-border); border-radius: 4px;">Alt + Shift + M</kbd>
      </li>
      <li style="display: flex; justify-content: space-between;">
        <span>Trainer Attendance / Sessions:</span>
        <kbd style="padding: 0.2rem 0.4rem; background: var(--color-surface-hover); border: 1px solid var(--color-border); border-radius: 4px;">Alt + Shift + A</kbd>
      </li>
      <li style="display: flex; justify-content: space-between;">
        <span>Analytics Dashboard:</span>
        <kbd style="padding: 0.2rem 0.4rem; background: var(--color-surface-hover); border: 1px solid var(--color-border); border-radius: 4px;">Alt + Shift + D</kbd>
      </li>
      <li style="display: flex; justify-content: space-between;">
        <span>Focus Check-in Code Field:</span>
        <kbd style="padding: 0.2rem 0.4rem; background: var(--color-surface-hover); border: 1px solid var(--color-border); border-radius: 4px;">Alt + Shift + K</kbd>
      </li>
      <li style="display: flex; justify-content: space-between;">
        <span>Open / Close Help Dialog:</span>
        <kbd style="padding: 0.2rem 0.4rem; background: var(--color-surface-hover); border: 1px solid var(--color-border); border-radius: 4px;">Alt + Shift + H</kbd>
      </li>
      <li style="display: flex; justify-content: space-between;">
        <span>Close Any Modal:</span>
        <kbd style="padding: 0.2rem 0.4rem; background: var(--color-surface-hover); border: 1px solid var(--color-border); border-radius: 4px;">Esc</kbd>
      </li>
    </ul>
    <div style="text-align: right; margin-top: 1rem;">
      <button type="button" class="btn btn-primary" onclick="document.getElementById('shortcuts-dialog').close()">
        Close
      </button>
    </div>
  </dialog>

  <!-- Footer landmark (WCAG 1.3.1) -->
  <footer class="site-footer" role="contentinfo">
    <div class="footer-container">

      <div class="footer-column footer-brand">
        <a href="/" class="footer-brand-link" aria-label="Workshop House homepage">Workshop House</a>
        <p class="footer-description">
          A short-course platform connecting learners, trainers, and coordinators.
        </p>
      </div>

      <div class="footer-column">
        <h2 class="site-footer__heading">Workshops</h2>
        <ul class="footer-link-list">
          <li><a href="/sessions" class="footer-link">Browse all sessions</a></li>
          {% if currentUser and currentUser.role == "learner" %}
            <li><a href="/my-sessions" class="footer-link">My enrolled sessions</a></li>
          {% endif %}
        </ul>
      </div>

      <div class="footer-column">
        <h2 class="site-footer__heading">Account</h2>
        <ul class="footer-link-list">
          {% if currentUser %}
            <li><a href="/preferences" class="footer-link">Preferences</a></li>
            <li><a href="/dashboard" class="footer-link">Dashboard</a></li>
            {% if currentUser.role == "coordinator" %}
              <li><a href="/coordinator/sessions" class="footer-link">Coordinator dashboard</a></li>
            {% endif %}
            {% if currentUser.role == "trainer" %}
              <li><a href="/trainer/sessions" class="footer-link">Trainer dashboard</a></li>
            {% endif %}
          {% else %}
            <li><a href="/auth/login" class="footer-link">Sign in</a></li>
          {% endif %}
        </ul>
      </div>

      <div class="footer-column footer-column--full">
        <p class="footer-copyright">&copy; 2026 Workshop House &middot; Advanced Web Programming</p>
      </div>

    </div>
  </footer>

  {% block scripts %}{% endblock %}
</body>
</html>
