{% extends "layout.njk" %}

{% block content %}
<div style="max-width: 600px; margin: 0 auto;">
  <h1>User Accessibility & Display Preferences</h1>

  {% include "components/error-summary.njk" %}

  <div class="card">
    <p>Customize your viewing and interaction experience. Your preferences are saved to your account and apply across sessions and devices.</p>

    <form action="/preferences" method="POST" novalidate style="margin-top: 1.5rem;">
      <!-- Text Scale -->
      <fieldset style="border: 2px solid var(--color-border); border-radius: var(--border-radius); padding: 1rem 1.25rem; margin-bottom: 1.5rem;">
        <legend style="font-weight: 700; padding: 0 0.5rem;">Text Size & Scaling</legend>
        <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-top: 0;">
          Adjust the base font size for improved readability.
        </p>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 0.5rem;">
          <label style="display: flex; align-items: center; gap: 0.5rem; min-height: 44px; cursor: pointer;">
            <input type="radio" name="text_scale" value="100" {% if values.text_scale == '100' or not values.text_scale %}checked{% endif %} />
            <span>100% (Default)</span>
          </label>
          <label style="display: flex; align-items: center; gap: 0.5rem; min-height: 44px; cursor: pointer;">
            <input type="radio" name="text_scale" value="125" {% if values.text_scale == '125' %}checked{% endif %} />
            <span>125% (Large)</span>
          </label>
          <label style="display: flex; align-items: center; gap: 0.5rem; min-height: 44px; cursor: pointer;">
            <input type="radio" name="text_scale" value="150" {% if values.text_scale == '150' %}checked{% endif %} />
            <span>150% (Extra Large)</span>
          </label>
        </div>
      </fieldset>

      <!-- Visual & Motion Settings -->
      <fieldset style="border: 2px solid var(--color-border); border-radius: var(--border-radius); padding: 1rem 1.25rem; margin-bottom: 1.5rem;">
        <legend style="font-weight: 700; padding: 0 0.5rem;">Contrast & Motion</legend>
        
        <div class="form-group" style="margin-bottom: 1rem;">
          <label style="display: flex; align-items: center; gap: 0.75rem; min-height: 44px; cursor: pointer;">
            <input type="checkbox" name="high_contrast" value="true" {% if values.high_contrast %}checked{% endif %} style="width: 20px; height: 20px;" />
            <span><strong>High Contrast Mode</strong> (Enhances text and border distinction)</span>
          </label>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <label style="display: flex; align-items: center; gap: 0.75rem; min-height: 44px; cursor: pointer;">
            <input type="checkbox" name="reduced_motion" value="true" {% if values.reduced_motion %}checked{% endif %} style="width: 20px; height: 20px;" />
            <span><strong>Reduce Motion</strong> (Disables transitions and animations)</span>
          </label>
        </div>
      </fieldset>

      <!-- Keyboard Shortcuts Toggle (WCAG 2.1.4) -->
      <fieldset style="border: 2px solid var(--color-border); border-radius: var(--border-radius); padding: 1rem 1.25rem; margin-bottom: 1.5rem;">
        <legend style="font-weight: 700; padding: 0 0.5rem;">Keyboard Shortcuts</legend>
        <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-top: 0;">
          In compliance with WCAG 2.1.4, character key shortcuts can be disabled to avoid interference with assistive speech inputs.
        </p>
        <div class="form-group" style="margin-bottom: 0;">
          <label style="display: flex; align-items: center; gap: 0.75rem; min-height: 44px; cursor: pointer;">
            <input type="checkbox" name="shortcuts_enabled" value="true" {% if values.shortcuts_enabled %}checked{% endif %} style="width: 20px; height: 20px;" />
            <span><strong>Enable Keyboard Shortcuts</strong> (Alt+Shift modifiers)</span>
          </label>
        </div>
      </fieldset>

      <div style="display: flex; gap: 1rem;">
        <button type="submit" class="btn btn-primary">Save Preferences</button>
        <a href="/" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
{% endblock %}
