{% extends "layout.njk" %}

{% block content %}
<div class="header-container" style="margin-bottom: 1.5rem; justify-content: space-between;">
  <h1>Manage Courses</h1>
  <a href="/coordinator/courses/new" class="btn btn-primary">+ Create New Course</a>
</div>

<p>
  <a href="/coordinator/sessions">&rarr; Switch to Manage Sessions</a>
</p>

{% if courses.length === 0 %}
  <div class="card">
    <p>No courses found. Create your first course to begin scheduling workshop sessions.</p>
  </div>
{% else %}
  <div class="table-responsive">
    <table aria-label="Course list">
      <thead>
        <tr>
          <th scope="col">Title</th>
          <th scope="col">Description</th>
          <th scope="col">Total Sessions</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for c in courses %}
          <tr>
            <td><strong>{{ c.title }}</strong></td>
            <td>{{ c.description | truncate(90, true, '...') }}</td>
            <td>{{ c.session_count }}</td>
            <td>
              <div style="display: flex; gap: 0.5rem;">
                <a href="/coordinator/courses/{{ c.id }}/edit" class="btn btn-secondary" style="min-height: 36px; padding: 0.25rem 0.6rem;">Edit</a>
                <form action="/coordinator/courses/{{ c.id }}/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this course? All associated sessions will also be removed.');">
                  <button type="submit" class="btn btn-secondary" style="min-height: 36px; padding: 0.25rem 0.6rem; color: var(--color-error-text);">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
{% endblock %}
